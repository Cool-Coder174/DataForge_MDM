# API Gateway base URL from the CloudFormation stack output `ApiBaseUrl`:
#   API=$(aws cloudformation describe-stacks --stack-name $STACK_NAME \
#     --query "Stacks[0].Outputs[?OutputKey=='ApiBaseUrl'].OutputValue" --output text)
#
# When this is empty/unset the dashboard runs in mock mode (bundled sample data),
# so it still demos without any AWS dependency.
VITE_API_BASE_URL=
