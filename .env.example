# ---------------------------------------------------------------------------
# DataForge MDM Demo - Environment configuration
# Copy this file to .env and fill in real values:  cp .env.example .env
# All scripts and Makefile targets source .env automatically.
# ---------------------------------------------------------------------------

# AWS region for all resources
AWS_REGION=us-east-1

# Short, lowercase project slug. Used to name/prefix every resource.
PROJECT_NAME=dataforge

# Globally-unique S3 bucket for the data lake (raw/processed/curated/master).
# Must be unique across all of AWS. Suggestion: <project>-<account_id>-<region>
DATA_BUCKET=dataforge-CHANGEME-us-east-1

# Email that receives SNS pipeline + data-quality alerts.
# You MUST confirm the SNS subscription email after first deploy.
ALERT_EMAIL=you@example.com

# Redshift (dimensional warehouse)
REDSHIFT_DATABASE=dataforge
REDSHIFT_USER=dataforge_admin
# Password is NOT stored here. It is generated/stored in AWS Secrets Manager.

# RDS PostgreSQL (MDM operational store)
RDS_DATABASE=mdm
RDS_USER=mdm_admin
# Password is NOT stored here. It is generated/stored in AWS Secrets Manager.

# CloudFormation root stack name
STACK_NAME=dataforge-mdm-demo

# ---------------------------------------------------------------------------
# Cost-control toggles (see README "Cost control")
#   true  = provision the expensive resource
#   false = skip it and rely on serverless/local fallbacks
# ---------------------------------------------------------------------------
ENABLE_RDS=true
ENABLE_REDSHIFT=false
ENABLE_QUICKSIGHT=false
